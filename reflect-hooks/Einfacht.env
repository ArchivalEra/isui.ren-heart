# Einfacht.env —— 本仓事实系统配置
#
# ⚠️ 本仓是**边缘部署仓**：main 分支是源码（Rust wasm + 中间件 + 站点根），
# deploy 分支是构建产物。Einfacht 只跟 main 跑，绝不进 deploy 分支。
export REFLECT_FACTS="FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,README.md,README.en.md,CONTEXT.md"
export REFLECT_QUESTIONS="questions"
export REFLECT_RETRACTIONS="retractions.json"
# 不变量闸门不启用（整行注释；空值会让 check_envfile 报「空不是通过」）
# export REFLECT_INVARIANTS="invariants.json"
export REFLECT_READMES="README.md,README.en.md"
export REFLECT_MEASURE_MODULE="measure_deploy"
