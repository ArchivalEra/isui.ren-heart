{
  "redirects": [
    {
      "source": "/blog",
      "destination": "/Blog",
      "statusCode": 301
    },
    {
      "source": "/mangomesa",
      "destination": "/MangoMesa",
      "statusCode": 301
    },
    {
      "source": "/mangomesa/",
      "destination": "/MangoMesa/",
      "statusCode": 301
    },
    {
      "source": "/static",
      "destination": "/static/",
      "statusCode": 301
    },
    {
      "source": "/probe-cap-dollar1/*",
      "destination": "https://raw.githubusercontent.com/ArchivalEra/Static-Contract/deploy/:$1",
      "statusCode": 302
    },
    {
      "source": "/probe-cap-splat/*",
      "destination": "https://raw.githubusercontent.com/ArchivalEra/Static-Contract/deploy/:splat",
      "statusCode": 302
    },
    {
      "source": "/probe-cap-star/*",
      "destination": "https://raw.githubusercontent.com/ArchivalEra/Static-Contract/deploy/*",
      "statusCode": 302
    }
  ]
}