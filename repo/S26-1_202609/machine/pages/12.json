  {
   "tex": "A^*=(A\\mid b)=\\begin{pmatrix}\na_{11} & a_{12} & \\cdots & a_{1n} & b_1\\\\\na_{21} & a_{22} & \\cdots & a_{2n} & b_2\\\\\n\\vdots & \\vdots & & \\vdots & \\vdots\\\\\na_{n1} & a_{n2} & \\cdots & a_{nn} & b_n\n\\end{pmatrix},\n\\tag{4.2}",
   "display": true
  },
  {
   "tex": "\\begin{pmatrix}\n1 & 0 & \\cdots & 0 & c_{11} & c_{12} & \\cdots & c_{1n} & d_1\\\\\n0 & 1 & \\cdots & 0 & c_{21} & c_{22} & \\cdots & c_{2n} & d_2\\\\\n0 & 0 & \\cdots & 1 & c_{31} & c_{32} & \\cdots & c_{3n} & d_3\\\\\n0 & 0 & \\cdots & 0 & c_{41} & c_{42} & \\cdots & c_{4n} & d_4\\\\\n\\vdots & & & \\vdots & \\vdots & & & \\vdots & \\vdots\\\\\n0 & 0 & \\cdots & 0 & 0 & 0 & \\cdots & 0 & d_n\n\\end{pmatrix},\n\\tag{4.3}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\nx_1+c_{11}x_2+\\cdots+c_{1n}x_n=d_1,\\\\\nx_2+c_{21}x_3+\\cdots+c_{2n}x_n=d_2,\\\\\nx_3+c_{31}x_4+\\cdots+c_{3n}x_n=d_3,\\\\[2pt]\n\\qquad\\vdots\\\\\n0=d_{n-1},\\\\\n0=0.\n\\end{cases}\n\\tag{4.4}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\nx_1=d_1,\\\\\nx_2=d_2,\\\\\n\\vdots\\\\\nx_n=d_n.\n\\end{cases}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\nx_1=d_1-c_{11}x_2-\\cdots-c_{1n}x_n,\\\\\nx_2=d_2-c_{21}x_3-\\cdots-c_{2n}x_n,\\\\\n\\qquad\\vdots\\\\\nx_{r-1}=d_{r-1}-c_{r-1,r}x_r-\\cdots-c_{r-1,n}x_n.\n\\end{cases}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\nx_1=d_1-c_{11}t_2-\\cdots-c_{1n}t_n,\\\\\nx_2=d_2-c_{21}t_3-\\cdots-c_{2n}t_n,\\\\\n\\qquad\\vdots\\\\\nx_r=d_r-c_{r,r+1}t_{r+1}-\\cdots-c_{r,n}t_n,\\\\\nx_{r+1}=t_{r+1},\\\\\nx_{r+2}=t_{r+2},\\\\\n\\qquad\\vdots\\\\\nx_n=t_n.\n\\end{cases}\n\\tag{4.5}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\nx_1-x_2+3x_3+x_4=1,\\\\\n2x_1-x_2+4x_3+2x_4=2,\\\\\n3x_1-2x_2+3x_3+3x_4=3,\\\\\nx_1-4x_2+5x_3-x_4=-1.\n\\end{cases}",
   "display": true
  },
  {
   "tex": "A^*=\\begin{pmatrix}\n1 & -1 & 3 & 1\\\\\n2 & -1 & 4 & 2\\\\\n3 & -2 & 3 & 3\\\\\n1 & -4 & 5 & -1\n\\end{pmatrix}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\nx_1+2x_2+3x_3+x_4=5,\\\\\n2x_1+2x_3-2x_4=2,\\\\\n-x_1-2x_2+3x_3+2x_4=8,\\\\\nx_1+2x_2-9x_3-5x_4=-21.\n\\end{cases}",
   "display": true
  },
  {
   "tex": "A^*=\\begin{pmatrix}\n1 & 2 & 3 & 1 & 5\\\\\n2 & 0 & 2 & -2 & 2\\\\\n-1 & -2 & 3 & 2 & 8\\\\\n1 & 2 & -9 & -5 & -21\n\\end{pmatrix}\n\\quad\\xrightarrow{\\text{初等行变换}}\\quad\n\\begin{pmatrix}\n1 & 2 & 3 & 1 & 5\\\\\n0 & -4 & -4 & -4 & -8\\\\\n0 & 0 & 6 & 3 & 13\\\\\n0 & 0 & -12 & -6 & -26\n\\end{pmatrix}",
