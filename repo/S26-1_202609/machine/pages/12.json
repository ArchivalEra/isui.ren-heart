  {
   "tex": "\\begin{cases}\nx_1=-\\dfrac{7}{6}+\\dfrac{3}{2}k,\\\\[2pt]\nx_2=-\\dfrac{1}{6}-\\dfrac{1}{2}k,\\\\[2pt]\nx_3=\\dfrac{13}{6}-\\dfrac{1}{2}k,\\\\[2pt]\nx_4=k.\n\\end{cases}",
