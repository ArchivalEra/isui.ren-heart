  },
  {
   "tex": "\\begin{cases}\nx_1-\\dfrac{3}{2}x_4=-\\dfrac{7}{6},\\\\[2pt]\nx_2+\\dfrac{1}{2}x_4=-\\dfrac{1}{6},\\\\[2pt]\nx_3+\\dfrac{1}{2}x_4=\\dfrac{13}{6}.\n\\end{cases}",
