  {
   "tex": "(1)\\ \\begin{vmatrix}2&-8\\\\5&6\\end{vmatrix};\\quad\n(2)\\ \\begin{vmatrix}\\sin\\alpha&\\cos\\alpha\\\\-\\cos\\alpha&\\sin\\alpha\\end{vmatrix};\\quad\n(3)\\ \\begin{vmatrix}-1&0\\\\0&2\\end{vmatrix};\\quad\n(4)\\ \\begin{vmatrix}2&-1\\\\0&3\\end{vmatrix}",
