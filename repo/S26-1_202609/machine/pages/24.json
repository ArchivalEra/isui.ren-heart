  },
  {
   "tex": "D_1=\\begin{vmatrix}b_1&a_{12}\\\\b_2&a_{22}\\end{vmatrix}=b_1a_{22}-a_{12}b_2,\\qquad\nD_2=\\begin{vmatrix}a_{11}&b_1\\\\a_{21}&b_2\\end{vmatrix}=a_{11}b_2-a_{21}b_1,",
   "display": true
  },
  {
   "tex": "x_1=\\frac{D_1}{D},\\qquad x_2=\\frac{D_2}{D}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\n3x_1-2x_2=12,\\\\\n2x_1+x_2=1.\n\\end{cases}",
