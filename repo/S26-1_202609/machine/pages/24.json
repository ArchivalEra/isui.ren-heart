   "tex": "D_1=\\begin{vmatrix}12&-2\\\\1&1\\end{vmatrix}=12-(-2)=14,\\qquad\nD_2=\\begin{vmatrix}3&12\\\\2&1\\end{vmatrix}=3-24=-21,",
   "display": true
