  },
  {
   "tex": "(1)\\ \\begin{cases}2x_1-x_2-x_3=4,\\\\3x_1+4x_2-2x_3=11,\\\\3x_1-2x_2+4x_3=11;\\end{cases}\\qquad\n(2)\\ \\begin{cases}2x_1-3x_2+x_3=-1,\\\\x_1+x_2+x_3=6,\\\\3x_1+x_2-2x_3=-1.\\end{cases}",
   "display": true
  },
  {
   "tex": "\\begin{cases}\n(5-\\lambda)x_1+2x_2+2x_3=0,\\\\\n2x_1+(6-\\lambda)x_2=0,\\\\\n2x_1+(4-\\lambda)x_3=0,\n\\end{cases}",
