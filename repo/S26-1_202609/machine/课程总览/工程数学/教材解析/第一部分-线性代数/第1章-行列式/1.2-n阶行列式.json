  {
   "tex": "D=\\begin{vmatrix}\n1&2&3&4\\\\\n4&1&2&3\\\\\n3&4&1&2\\\\\n2&3&4&1\n\\end{vmatrix}\n\\xrightarrow[\\substack{c_2+c_1\\\\c_3+c_1\\\\c_4+c_1}]{}\n\\begin{vmatrix}\n10&2&3&4\\\\\n10&1&2&3\\\\\n10&4&1&2\\\\\n10&3&4&1\n\\end{vmatrix}\n=10\\begin{vmatrix}\n1&2&3&4\\\\\n1&1&2&3\\\\\n1&4&1&2\\\\\n1&3&4&1\n\\end{vmatrix}",
